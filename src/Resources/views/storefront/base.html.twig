{#
    CronixAvantLink Plugin - Base Template Override
    Provides configurable AvantLink script injection positions across the storefront.
#}

{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% set merchantId = config('CronixAvantLink.config.merchantId') %}
{% set merchantIdNumeric = merchantId is not empty and merchantId matches '/^\\d+$/' %}
{% set position = config('CronixAvantLink.config.injectionPosition') %}
{% set testMode = config('CronixAvantLink.config.testMode') %}
{% set currentRoute = app.request.attributes.get('_route') %}

{% block base_head %}
    {{ parent() }}
    {% if merchantIdNumeric and position == 'head' %}
        <script async src="https://cdn.avmws.com/10{{ merchantId|e('js') }}/"></script>
        {% if testMode %}
            <script>
                console.info('CronixAvantLink: AvantLink sitewide script loaded in HEAD for merchant {{ merchantId|e('js') }}');
            </script>
        {% endif %}
    {% elseif position == 'head' and testMode %}
        <script>
            console.warn('CronixAvantLink: merchant ID must be numeric to load sitewide script. Current value: {{ merchantId|default('')|e('js') }}');
        </script>
    {% endif %}
    <script>
        console.info('CronixAvantLink debug: base_head executed, route {{ currentRoute|default('N/A')|e('js') }}');
    </script>
{% endblock %}

{% block base_body %}
    {% if merchantIdNumeric and position == 'body_start' %}
        <script async src="https://cdn.avmws.com/10{{ merchantId|e('js') }}/"></script>
        {% if testMode %}
            <div style="color:green;">AvantLink injected at body start</div>
        {% endif %}
    {% elseif position == 'body_start' and testMode %}
        <div style="color:red;">AvantLink merchant ID must be numeric to load script.</div>
    {% endif %}
    {{ parent() }}
    <script>
        console.info('CronixAvantLink debug: base_body executed with position {{ position|e('js') }} and route {{ currentRoute|default('N/A')|e('js') }}');
    </script>
{% endblock %}

{% block base_body_script %}
    {{ parent() }}
    {% if merchantIdNumeric and position == 'body_end' %}
        <script async src="https://cdn.avmws.com/10{{ merchantId|e('js') }}/"></script>
        {% if testMode %}
            <div style="color:green;">AvantLink injected at body end</div>
        {% endif %}
    {% elseif position == 'body_end' and testMode %}
        <div style="color:red;">AvantLink merchant ID must be numeric to load script.</div>
    {% endif %}

    {% if currentRoute == 'frontend.checkout.finish.page' %}
        {% sw_include '@CronixAvantLink/storefront/component/avantlink/order-tracking-script.html.twig' with {
            merchantId: merchantId,
            testMode: testMode,
            page: page
        } only %}
    {% else %}
        <div style="color:purple;">CronixAvantLink debug: base_body_script route {{ currentRoute|default('N/A') }} does not match checkout finish.</div>
    {% endif %}
    <script>
        console.info('CronixAvantLink debug: base_body_script executed on route {{ currentRoute|default('N/A')|e('js') }}');
    </script>
{% endblock %}

{% block base_esi_footer %}
    {{ parent() }}
    {% if merchantIdNumeric and position == 'footer' %}
        <script async src="https://cdn.avmws.com/10{{ merchantId|e('js') }}/"></script>
        {% if testMode %}
            <div style="color:green;">AvantLink injected in footer</div>
        {% endif %}
    {% elseif position == 'footer' and testMode %}
        <div style="color:red;">AvantLink merchant ID must be numeric to load script.</div>
    {% endif %}
    <script>
        console.info('CronixAvantLink debug: base_esi_footer executed with position {{ position|e('js') }}');
    </script>
{% endblock %}
